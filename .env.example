# SQLite for local dev (default). Swap to Postgres for deploy:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/shortener
DATABASE_URL=sqlite:///./shortener.db

# Used to build the short URLs returned by the API
BASE_URL=http://localhost:8000

# Codes are generated from the row id offset by this, so you never
# hand out 1-character codes. Bump it if you want longer codes.
ID_OFFSET=100000
