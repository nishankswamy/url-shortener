# --- database --------------------------------------------------------------
# SQLite locally. Swap to Postgres for deploy — nothing else changes.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/shortener
DATABASE_URL=sqlite:///./shortener.db

# --- app -------------------------------------------------------------------
BASE_URL=http://localhost:8000

# obfuscated = fixed 6 chars, not enumerable (default)
# sequential = shortest possible, but anyone can walk your links
SHORTCODE_MODE=obfuscated
ID_OFFSET=100000

# --- auth ------------------------------------------------------------------
# Comma-separated keys guarding link creation and analytics. Redirects stay
# public. Empty means open mode — fine locally, never in production.
# API_KEYS=change-me,second-key
API_KEYS=

# --- cache and click buffering ---------------------------------------------
# Both are off by default. Measured on one machine with SQLite they buy
# nothing (see the benchmarks in README) — they're bets on a remote Postgres.
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=
CACHE_TTL=3600

# CLICK_BUFFER=on batches click writes through Redis instead of one INSERT
# per redirect. Requires REDIS_URL. Buffered clicks are lost if the process
# dies — acceptable for analytics, not for anything billable.
CLICK_BUFFER=off
FLUSH_INTERVAL=5
FLUSH_BATCH_SIZE=500

# background = write the click after the response is sent (default)
# sync       = write it inline; exists so bench_http.py can compare the two
CLICK_MODE=background
